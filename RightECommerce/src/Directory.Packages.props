<Project>
    <PropertyGroup>
        <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>
</Project>