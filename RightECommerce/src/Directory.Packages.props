<Project>
    <PropertyGroup>
        <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="2.1.0" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="2.1.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="2.1.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="2.1.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="2.1.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="15.7.2" />
        <PackageVersion Include="xunit" Version="2.3.1" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="2.3.1" />
    </ItemGroup>
</Project>